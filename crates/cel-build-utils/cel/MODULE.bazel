"""Bazel module definition for cel-cxx (libcel)."""
module(
    name = "cel",
)

# Core dependencies
bazel_dep(name = "rules_cc", version = "0.2.25")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")

# Apple/iOS support (needed for Apple platform constraints)
bazel_dep(name = "apple_support", version = "2.9.0")

# Android NDK support (conditional - only when ANDROID_NDK_HOME is set)
bazel_dep(name = "rules_android_ndk", version = "0.1.5")

# rules_android_ndk's toolchain does not declare the archive_param_file
# feature, so cc_static_library passes ~600 object paths on the archiver's
# command line and exceeds CreateProcessW's 32767-character limit on
# Windows hosts. The auto-configured MSVC toolchain enables that feature
# for itself; mirror it here (llvm-ar accepts @response files). The url,
# integrity, and strip_prefix point at the same source the Bazel Central
# Registry serves for 0.1.5; the registry's version-bump patch is
# registry bookkeeping and is not needed for an override.
archive_override(
    module_name = "rules_android_ndk",
    url = "https://github.com/bazelbuild/rules_android_ndk/releases/download/v0.1.5/rules_android_ndk-v0.1.5.tar.gz",
    integrity = "sha256-B+eid3ETuz0KQyJl0ceM+qFApbxMgr5MjNmIs0OC7JA=",
    strip_prefix = "rules_android_ndk-0.1.5",
    patches = [
        "//:rules_android_ndk_archive_param_file.patch",
    ],
    patch_strip = 0,
)

# Use our conditional Android NDK extension
# This creates either a real Android NDK repository or a stub, depending on ANDROID_NDK_HOME
android_conditional = use_extension("//:android_conditional.bzl", "conditional_android_ndk")
use_repo(android_conditional, "androidndk")

# Register Android NDK toolchains
# This will register empty toolchains if Android NDK is not available
register_toolchains("@androidndk//:all")

# Cross-compilation support for cross-rs
bazel_dep(name = "rules_cross_rs", version = "0.2.0")
git_override(
    module_name = "rules_cross_rs",
    remote = "https://github.com/xjasonli/rules_cross_rs.git",
    commit = "968a444368a7b5681d1fd6f49391eb2f838706bb",
)

# Register the cross-rs toolchain from the root module. Bzlmod ranks
# root-module registrations above dependency and auto-configured local
# toolchains, so the cross-rs toolchain wins whenever the target platform
# also matches the local toolchain — e.g. building x86_64-unknown-linux-musl
# inside an x86_64 glibc cross-rs container, where both match
# [cpu:x86_64, os:linux] and the local glibc toolchain would otherwise
# mis-compile libcel. The extension generates a stub toolchain with
# impossible constraints when not building under cross-rs, so native builds
# (including native musl hosts like Alpine, which resolve their own
# auto-configured toolchain) are unaffected.
# androidndk is registered above, so NDK toolchains keep winning on Android
# platforms; cross-rs fills in for Android targets when no NDK is available.
cross_rs_ext = use_extension("@rules_cross_rs//:rules.bzl", "cross_rs_extension")
use_repo(cross_rs_ext, "cross_rs_toolchain")
register_toolchains("@cross_rs_toolchain//:toolchain_definition")

# MinGW-w64 toolchain for x86_64-pc-windows-gnu (e.g. MSYS2 UCRT64 hosts).
# The extension generates a real gcc toolchain from the MinGW tools on PATH
# only when cargo's TARGET is the gnu triple and cross-rs is not in charge
# (rules_cross_rs owns that case, as on musl/wasm); otherwise it generates
# a stub with impossible constraints, so every other target keeps resolving
# its usual toolchain. Root-module registration outranks the
# auto-configured MSVC toolchain on the platform's shared
# [cpu:x86_64, os:windows] constraints — the same ranking the
# rules_cross_rs registration above relies on.
mingw_ext = use_extension("//:mingw_conditional.bzl", "conditional_mingw_toolchain")
use_repo(mingw_ext, "mingw_toolchain")
register_toolchains("@mingw_toolchain//:toolchain_definition")

# Abseil-CPP dependency
bazel_dep(
    name = "abseil-cpp",
    version = "20260526.0",
    repo_name = "com_google_absl",
)

# CEL-CPP dependency
bazel_dep(name = "cel-cpp")
git_override(
    module_name = "cel-cpp",
    # We need some patches
    remote = "https://github.com/xjasonli/cel-cpp.git",
    commit = "c84e883df5932dcc992dd3494a771c37e85ae1fe",
    patches = [
        # Windows ships no TZif zone database for cctz, so named IANA zones
        # resolve through the OS-managed database via C++20 <chrono> instead
        # (see docs/timezone-support-design.md, Option G).
        "//:windows_chrono_timezone.patch",
        # Cross-compiling from a Windows host (e.g. Android via cargo-ndk)
        # trips a target-vs-host mismatch in cel-cpp's ANTLR copy actions:
        # the grammar output layout depends on the executing host's file
        # separator, but antlr.bzl selects on the target platform. Fall back
        # to the flat output location when the prefixed one is missing.
        "//:antlr_cross_host_output.patch",
        # The same actions also selected their shell by target platform
        # (PowerShell.exe for Windows targets), which does not exist on
        # Linux hosts building windows-gnu via cross-rs. Run the copies
        # through the default shell instead and always try both output
        # layouts.
        "//:cel_cpp_antlr_exec_shell.patch",
        # MinGW (x86_64-pc-windows-gnu) defines _WIN32 but uses the Itanium
        # ABI like GCC elsewhere: route the type-name demangling through
        # abi::__cxa_demangle instead of the MSVC-only __unDName/raw_name.
        "//:cel_cpp_mingw_demangle.patch",
    ],
    patch_strip = 0,
)
