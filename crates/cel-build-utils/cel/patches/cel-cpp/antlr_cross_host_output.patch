@@ -93,6 +93,16 @@ def _antlr_library(ctx):
 
         executable = ctx.attr.shell
 
+        # The ANTLR tool decides whether generated files keep the grammar
+        # file's directory prefix using the *executing host's* file
+        # separator, while genfiles_prefixed above selects on the target
+        # platform. When cross-compiling from a Windows host the tool
+        # writes the flat layout, so fall back to the basename location
+        # there. Host-native builds keep taking the first branch.
+        copy_command = 'cp "{generated}" "{out}"'
+        if prefix != basename:
+            copy_command = copy_command + ' || cp "{flat}" "{out}"'
+
         ctx.actions.run(
             mnemonic = "CopyHeader" + suffix,
             inputs = [output],
